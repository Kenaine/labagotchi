[Unit]
Description=Labagotchi FastAPI Backend & Static Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/labagotchi/backend
Environment="PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
